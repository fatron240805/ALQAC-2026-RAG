# ALQAC API
ALQAC_TEAM_TOKEN=your_alqac_team_token
ALQAC_API_URL=https://alqac-api.example.com

# Local or OpenAI-compatible LLM
ALQAC_LLM_PROVIDER=ollama
ALQAC_LLM_BASE_URL=http://localhost:11434
ALQAC_LLM_MODEL_NAME=your-model-name
ALQAC_LLM_API_KEY=your_llm_api_key
ALQAC_LLM_TIMEOUT_SECONDS=120
ALQAC_LLM_MAX_RETRIES=2

# Neo4j graph store
# bolt localhost hoặc là connect cloud bằng neo4j+s
NEO4J_URI=bolt://localhost:7687 
NEO4J_USERNAME=neo4j 
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=10
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60
NEO4J_IMPORT_BATCH_SIZE=200

# Runtime behaviour
SECONDS_BETWEEN_API_CALLS=5
FAILURE_BACKOFF_SECONDS=10
