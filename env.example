# ==============================================================================
# CONFIGURATION FOR ALQAC 2026 LEGAL AGENTIC RAG SYSTEM
# ==============================================================================

# 1. API BAN TỔ CHỨC CUNG CẤP (BẮT BUỘC ĐỂ RETRIEVE EVIDENCE)
# Token bí mật duy nhất của đội thi dùng để gọi API và submit leaderboard
ALQAC_TEAM_TOKEN=replace_with_team_token

# Đường dẫn API chính thức từ Ban tổ chức dùng để truy vấn nội dung vụ án
ALQAC_API_URL=https://alqac-api.ngrok.pro


# 2. CẤU HÌNH KẾT NỐI SERVER MÔ HÌNH NỀN TẢNG (LLM SERVER)
# Thay đổi link ngrok tương ứng với địa chỉ sinh ra ở Ô Code 1 trên Kaggle mỗi lần restart
ALQAC_LLM_PROVIDER=ollama
ALQAC_LLM_BASE_URL=http://localhost:11434

# Tên mô hình chính thức được nhóm thống nhất sử dụng (hợp lệ <10B theo quy chế)
ALQAC_LLM_MODEL_NAME=qwen3:8b
ALQAC_LLM_TIMEOUT_SECONDS=300
ALQAC_LLM_MAX_RETRIES=2


# 3. THÔNG SỐ ĐIỀU PHỐI PIPELINE & HẠ TẦNG LOCAL
# Khoảng thời gian nghỉ cố định giữa các lệnh gọi API của BTC (Luật quy định nghiêm ngặt 5s/request)
SECONDS_BETWEEN_API_CALLS=5.0

# Thời gian ngủ bù cơ bản phục vụ cho cơ chế Exponential Backoff khi LLM mất kết nối
FAILURE_BACKOFF_SECONDS=2.0
